  "license": "MIT",
  "type": "module",
  "bin": { "vortr-mcp": "dist/index.js" },
  "files": ["dist", "llms.txt", "SKILL.md", "README.md"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=18" },
